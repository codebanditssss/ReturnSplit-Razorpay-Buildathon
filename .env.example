# Optional: a separately deployed TimesFM 2.5 inference service.
TIMESFM_ENDPOINT=http://127.0.0.1:8091/v1/forecast
TIMESFM_API_TOKEN=local-secret
TIMESFM_TIMEOUT_MS=5000

# Optional reserve shown on the Risk page, in integer paise (₹4,00,000 here).
REFUND_RESERVE_PAISE=40000000

# Optional Razorpay Test Mode only. Never prefix secrets with NEXT_PUBLIC_.
# Keep `demo` for the seeded scenarios. Set `razorpay_test` only after importing
# matching Test Mode payment/transfer IDs; seeded `*_demo_*` IDs are blocked.
RETURNSPLIT_PROVIDER_MODE=demo
# Required for browser mutations in production. Include scheme and port, with
# no path (for example, https://returns.example or http://localhost:3000).
RETURNSPLIT_APP_ORIGIN=http://localhost:3000
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace_me
RAZORPAY_REQUEST_TIMEOUT_MS=8000
RAZORPAY_WEBHOOK_SECRET_CURRENT=replace_me
# Keep the previous value only while rotating webhook secrets.
RAZORPAY_WEBHOOK_SECRET_PREVIOUS=
